rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Comments are publicly readable. Writes go through /api/comments so the
    // server can verify Firebase ID tokens and validate payloads consistently.
    match /comments/{aptSlug}/messages/{messageId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
