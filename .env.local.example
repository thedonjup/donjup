# CockroachDB (메인 DB)
DATABASE_URL=postgresql://user:password@host:26257/donjup?sslmode=verify-full
# 서버리스 무료 DB 보호용. 기본값 2, 트래픽/유료 전환 전까지 1~2 권장.
DB_POOL_MAX=2
# 페이지뷰 DB 쓰기 샘플링 비율. 1=전체 기록, 0=DB 기록 중지, 0.1=10% 기록 후 카운트 보정.
DONJUP_PAGEVIEW_WRITE_SAMPLE_RATE=1
# DB 업로드 전 이 컴퓨터에 누적 저장할 로컬 데이터 디렉터리.
DONJUP_LOCAL_DATA_DIR=.donjup-local-data
# DB health 점검 경고 기준. 0으로 두면 해당 경고를 끈다.
DONJUP_LOCAL_DATA_WARN_MB=8192
DONJUP_CORE_TRANSACTION_ROWS_WARN=8000000
DONJUP_PAGEVIEW_ROWS_WARN=100000
DONJUP_LOCAL_DB_DELTA_WARN=1000

# Supabase Storage (이미지 등 파일 저장용, DB는 사용하지 않음)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# 외부 API
MOLIT_API_KEY=your-molit-api-key
ECOS_API_KEY=your-ecos-api-key

# 한국부동산원
REB_API_KEY=your-reb-api-key

# 금융감독원 DART (전자공시)
DART_API_KEY=your-dart-api-key

# 금융감독원 금융상품한눈에 (은행별 대출금리)
FINLIFE_API_KEY=your-finlife-api-key

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# 카카오맵
NEXT_PUBLIC_KAKAO_JS_KEY=your-kakao-js-key
KAKAO_REST_KEY=your-kakao-rest-key

# Vercel Cron
CRON_SECRET=your-cron-secret

# Maintenance-only DB mutation/debug routes. Keep false in normal production.
DONJUP_ENABLE_MAINTENANCE_ROUTES=false

# Google
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXX

# SEO / Sitemap
# 1개 sitemap당 아파트 URL 10,000개. 빌드 시 DB count를 하지 않기 위한 상한값.
DONJUP_APT_SITEMAP_COUNT=10

# Coupang Partners
COUPANG_ACCESS_KEY=your-coupang-access-key
COUPANG_SECRET_KEY=your-coupang-secret-key
COUPANG_AF_CODE=your-coupang-af-code

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# 네이버 검색 API (뉴스)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Slack (에러 알림)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Vercel Blob (이미지 저장용)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Facebook / Instagram
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_USER_ID=your-instagram-business-account-id
# 레거시 (참고용)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_PAGE_ID=your-facebook-page-id
